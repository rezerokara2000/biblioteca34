---
// Alternador OG / TR. Está oculto: el script de la página lo muestra
// solo si existe al menos una imagen con tr_url válida.
---

<div id="selector-version" class="hidden">
  <div class="inline-flex overflow-hidden rounded-lg border border-white/15" role="group" aria-label="Versión de la imagen">
    <button
      id="btn-og"
      type="button"
      aria-pressed="true"
      class="px-5 py-2 text-sm font-bold text-white/70 transition hover:text-white aria-pressed:bg-acento aria-pressed:text-black"
    >
      OG
    </button>
    <button
      id="btn-tr"
      type="button"
      aria-pressed="false"
      class="px-5 py-2 text-sm font-bold text-white/70 transition hover:text-white aria-pressed:bg-acento aria-pressed:text-black"
    >
      TR
    </button>
  </div>
</div>
