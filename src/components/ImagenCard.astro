---
// Plantilla de la tarjeta de imagen. ImagenesGrid la clona por cada resultado.
// El enlace de la miniatura cubre toda la tarjeta; el del artista queda encima (z-10).
---

<template id="tpl-imagen">
  <article class="bg-panel border-acento/30 hover:border-acento relative overflow-hidden rounded-xl border transition hover:shadow-[0_0_16px_rgba(34,211,238,0.3)]">
    <a data-link class="block after:absolute after:inset-0 after:content-['']">
      <div class="bg-fondo aspect-[4/3]">
        <img data-img class="h-full w-full object-cover" alt="" loading="lazy" decoding="async" />
      </div>
    </a>

    <div class="p-3.5">
      <div class="flex items-center justify-between gap-2">
        <a data-artista class="hover:text-acento relative z-10 truncate text-lg font-semibold"></a>
        <span data-badge></span>
      </div>
      <p data-tags class="mt-1 truncate text-sm text-white/60"></p>
    </div>
  </article>
</template>
