---
import Buscador from './Buscador.astro';
import FiltroClasificacion from './FiltroClasificacion.astro';

interface Props {
  placeholder: string;
}

const { placeholder } = Astro.props;
---

<div class="flex flex-col gap-3 lg:flex-row lg:items-center">
  <div class="flex-1">
    <Buscador id="buscador" placeholder={placeholder} />
  </div>
  <FiltroClasificacion />
</div>
