---
interface Props {
  activo: 'artistas' | 'imagenes' | 'colecciones';
}

const { activo } = Astro.props;

const enlaces = [
  { id: 'artistas', texto: 'Artistas', href: '/', icono: 'user' },
  { id: 'imagenes', texto: 'Imágenes', href: '/imagenes', icono: 'image' },
  { id: 'colecciones', texto: 'Colecciones', href: '/colecciones', icono: 'folder' },
] as const;
---

<!-- Botón hamburguesa -->
<button
  id="menu-boton"
  type="button"
  aria-label="Abrir menú"
  aria-expanded="false"
  aria-controls="menu-panel"
  class="fixed top-4 left-4 z-40 flex h-11 w-11 items-center justify-center rounded-lg border border-white/10 bg-panel text-white transition hover:border-acento hover:text-acento"
>
  <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <path d="M4 6h16M4 12h16M4 18h16"></path>
  </svg>
</button>

<!-- Fondo oscuro -->
<div id="menu-fondo" class="pointer-events-none fixed inset-0 z-40 bg-black/60 opacity-0 transition-opacity"></div>

<!-- Panel lateral -->
<nav
  id="menu-panel"
  aria-label="Navegación principal"
  class="fixed top-0 left-0 z-50 h-full w-64 -translate-x-full border-r border-white/10 bg-fondo p-4 transition-transform"
>
  <button
    id="menu-cerrar"
    type="button"
    aria-label="Cerrar menú"
    class="mb-6 flex h-11 w-11 items-center justify-center rounded-lg text-white/70 hover:text-acento"
  >
    <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>
  </button>

  <ul class="space-y-2">
    {
      enlaces.map((e) => (
        <li>
          <a
            href={e.href}
            class:list={[
              'flex items-center gap-3 rounded-lg border px-4 py-3 text-base transition',
              activo === e.id
                ? 'border-acento text-white shadow-[0_0_12px_rgba(34,211,238,0.35)]'
                : 'border-transparent text-white/70 hover:bg-panel hover:text-white',
            ]}
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              {e.icono === 'user' && (
                <>
                  <circle cx="12" cy="8" r="4" />
                  <path d="M4 21c0-4 4-6 8-6s8 2 8 6" />
                </>
              )}
              {e.icono === 'image' && (
                <>
                  <rect x="3" y="4" width="18" height="16" rx="2" />
                  <circle cx="9" cy="10" r="1.5" />
                  <path d="M21 16l-5-5-8 9" />
                </>
              )}
              {e.icono === 'folder' && <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />}
            </svg>
            {e.texto}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const boton = document.getElementById('menu-boton')!;
  const panel = document.getElementById('menu-panel')!;
  const fondo = document.getElementById('menu-fondo')!;
  const cerrar = document.getElementById('menu-cerrar')!;

  function abrir(abierto: boolean) {
    panel.classList.toggle('-translate-x-full', !abierto);
    fondo.classList.toggle('opacity-0', !abierto);
    fondo.classList.toggle('pointer-events-none', !abierto);
    boton.setAttribute('aria-expanded', String(abierto));
    document.body.classList.toggle('overflow-hidden', abierto);
  }

  boton.addEventListener('click', () => abrir(true));
  cerrar.addEventListener('click', () => abrir(false));
  fondo.addEventListener('click', () => abrir(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') abrir(false);
  });
</script>
